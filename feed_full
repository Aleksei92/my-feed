<?xml version="1.0" encoding="UTF-8"?>
<!--
  Справочный общий YML-фид для импорта товаров Flowwow.
  Составлен по странице Confluence «Импорт» (pageId 1577648147).

  Имя файла: только латиница/цифры, допустимы _ и -, без пробелов,
  скобок, спецсимволов и дополнительных точек.

  Важно:
  - ID существующего товара используется для обновления товара.
  - Новый уникальный ID создаёт новый товар.
  - Исчезнувший из следующего фида товар скрывается.
  - DOCTYPE и ENTITY не поддерживаются.
-->
<yml_catalog date="2026-08-19T12:00:00+02:00">
    <!-- Корневой элемент. Атрибут date содержит дату и время формирования фида. -->
    <shop>
        <!-- Обязательное название магазина. -->
        <name>Флоувоу</name>

        <!-- Обязательная информация о компании магазина. -->
        <company>ООО «Флоувоу»</company>

        <!-- Обязательный корректный URL магазина. -->
        <url>https://flowwow.example</url>

        <!--
          Перечень валют, используемых товарами. currencyId внутри offer должен
          ссылаться на объявленную валюту; без currencyId применяется валюта магазина.
        -->
        <currencies>
            <currency id="RUR" rate="1"/>
        </currencies>

        <!--
          Обязательный каталог категорий фида. ID категории затем указывается
          в categoryId/category_id товара и сопоставляется с категорией площадки.
        -->
        <categories>
            <category id="75">Цветы монобукеты</category>
            <category id="3">Кондитерские и пекарни</category>
            <category id="6">Комнатные растения</category>
            <category id="10">Одежда</category>
            <category id="15">Картины</category>
            <category id="17">Подарочные сертификаты</category>
            <category id="22">Цветы оптом</category>
        </categories>

        <!-- Обязательный контейнер списка всех товаров. -->
        <offers>
            <!--
              УНИВЕРСАЛЬНЫЙ ТОВАР
              id обязателен и уникален; документация указывает максимум 20 символов,
              цифры и латиница. available желательно: true — доступен, false — скрыт.
            -->
            <offer id="flower4438" available="true">
                <!-- Опциональная ссылка на страницу товара, максимум 2048 символов. -->
                <url>https://flowwow.example/goods/4438</url>

                <!--
                  Обязательный ID категории из блока categories.
                  Допустимый алиас тега: category_id.
                -->
                <categoryId>75</categoryId>

                <!--
                  Опциональная валюта этого товара. Если тег отсутствует,
                  применяется валюта магазина.
                -->
                <currencyId>RUR</currencyId>

                <!-- Обязательная положительная цена товара. -->
                <price>289.99</price>

                <!-- Опциональная предыдущая цена товара до скидки. -->
                <oldprice>349.99</oldprice>

                <!--
                  Обязательное название товара. Допустимый алиас: model.
                  При сохранении проверяется ограничение: максимум 128 символов.
                -->
                <name>Букет из роз</name>

                <!-- Бренд/производитель товара; присутствует в примерах фида. -->
                <vendor>Флоувоу</vendor>

                <!--
                  Обязательная ссылка на изображение. Допустимый алиас: image.
                  Можно повторять тег; первое изображение становится обложкой.
                -->
                <picture>https://flowwow.example/images/flower4438-cover.jpg</picture>
                <picture>https://flowwow.example/images/flower4438-2.jpg</picture>

                <!-- Обязательное подробное описание товара. -->
                <description>Классический букет из свежих роз с атласной лентой.</description>

                <!--
                  Вес в килограммах. Желателен; обязателен для ряда продуктовых
                  категорий и для доставки СДЭК. Если тег отсутствует, кроме категории
                  «Кондитерские и пекарни» по умолчанию устанавливается 100 г.
                -->
                <weight>0.5</weight>

                <!--
                  Ширина и высота обязательны, кроме подарочных сертификатов,
                  одежды и обуви. Единица указывается в name на русском: мм или см.
                  Для доставки СДЭК размеры обязательны.
                -->
                <param name="Ширина, мм">450</param>
                <param name="Высота, мм">500</param>

                <!-- Длина опциональна для обычного товара, но обязательна для СДЭК. -->
                <param name="Длина, мм">450</param>

                <!--
                  Альтернативная запись всех трёх размеров в сантиметрах.
                  Формат из документации: 10х20х30 (буква «х», не символ /).
                  Обычно используйте либо этот тег, либо отдельные размеры выше.
                -->
                <param name="размер">45х45х50</param>

                <!--
                  Состав: каждый компонент отдельным тегом. Название элемента — name,
                  единица «шт» распознаётся на русском, число — содержимое тега.
                  Обязательно для категорий «Цветы» и «Вкусные наборы».
                -->
                <consist name="Роза 50 см" unit="шт">11</consist>
                <consist name="Лента атласная" unit="шт">1</consist>

                <!--
                  Остаток товара. Желателен и не может быть отрицательным.
                  Алиасы: quantity, count, amount.
                -->
                <qty>25</qty>

                <!-- Опциональное минимальное количество для заказа. -->
                <minorder>1</minorder>

                <!--
                  Опциональный признак доставки СДЭК. При true магазин должен быть
                  подключён к СДЭК, а у товара обязательны вес и три размера.
                  Лимиты из документации: до 30 000 г и до 150 000 куб. см.
                -->
                <delivery>true</delivery>

                <!--
                  Признак товара 18+. Для контента для взрослых должен быть true.
                -->
                <adult>false</adult>

                <!--
                  Время изготовления в минутах. Если при первом импорте не указано,
                  устанавливается 1 минута. Ручное изменение не перезаписывается
                  последующими фидами, пока production_time снова не передан.
                -->
                <production_time>60</production_time>

            </offer>

            <!-- КОНДИТЕРСКИЕ И ПЕКАРНИ: вес и состав обязательны. -->
            <offer id="bakery1001" available="true">
                <categoryId>3</categoryId>
                <currencyId>RUR</currencyId>
                <price>2500</price>
                <name>Торт с клубникой</name>
                <picture>https://flowwow.example/images/bakery1001.jpg</picture>
                <description>Бисквитный торт со свежей клубникой.</description>
                <!-- Для BakerySpecialYmlStrategy вес ищется: weight, затем description, затем name. -->
                <weight>1.2</weight>
                <param name="Ширина, см">20</param>
                <param name="Высота, см">12</param>
                <param name="Длина, см">20</param>
                <!--
                  Обязательный состав для «Кондитерские и пекарни» и
                  «Косметика и парфюмерия». Алиасы имени: consist и «Состав».
                  Для кондитерской стратегии при отсутствии параметра состав берётся
                  из description.
                -->
                <param name="composition">Мука пшеничная, сахар, яйца, сливочное масло, молоко, клубника.</param>
                <qty>5</qty>
                <!--
                  Тип документа 1 требует ссылку только вида
                  https://pub.fsa.gov.ru/rds/declaration/view/...
                  Для типа 2 разрешён https://pub.fsa.gov.ru/rss/certificate/view/...
                  Для типа 3 — https://nsi.eaeunion.org/portal/...
                  При типе 4 ссылка очищается.
                -->
                <compliance_document_type>1</compliance_document_type>
                <compliance_document_link>https://pub.fsa.gov.ru/rds/declaration/view/123</compliance_document_link>
            </offer>

            <!-- КОМНАТНЫЕ РАСТЕНИЯ: обязательна периодичность полива. -->
            <offer id="plant1001" available="true">
                <categoryId>6</categoryId>
                <price>1800</price>
                <name>Фикус в кашпо</name>
                <picture>https://flowwow.example/images/plant1001.jpg</picture>
                <description>Неприхотливое комнатное растение.</description>
                <param name="Ширина, см">25</param>
                <param name="Высота, см">60</param>
                <!--
                  Обязательно для «Комнатные растения». Допустимые единицы:
                  week/weeks, неделя/недели/недель, month/months,
                  месяц/месяца/месяцев.
                -->
                <watering_frequency unit="недель">1</watering_frequency>
                <!-- Материал обязателен, если поле обязательно в выбранной подкатегории. -->
                <material>Керамика</material>
            </offer>

            <!-- ОДЕЖДА/ОБУВЬ/ДЕТСКАЯ ОДЕЖДА: пример поля «Для кого». -->
            <offer id="clothes1001" available="true">
                <categoryId>10</categoryId>
                <price>3900</price>
                <name>Женский свитер</name>
                <picture>https://flowwow.example/images/clothes1001.jpg</picture>
                <description>Тёплый женский свитер.</description>
                <!--
                  gender обязателен для обуви с выбором «Для кого», мужской/женской
                  одежды и детской одежды. Допустимы русские и английские варианты:
                  мужчины, женщины, дети, мальчики, девочки, новорождённые и аналоги.
                -->
                <gender>женщина</gender>
                <material>Шерсть</material>
                <!-- Для одежды остаток обязателен; алиасы также count/amount/quantity. -->
                <quantity>12</quantity>
            </offer>

            <!-- КАРТИНЫ: обязательны автор и оригинальность. -->
            <offer id="painting1001" available="true">
                <categoryId>15</categoryId>
                <price>25000</price>
                <name>Картина «Летний сад»</name>
                <picture>https://flowwow.example/images/painting1001.jpg</picture>
                <description>Пейзаж, масло на холсте.</description>
                <param name="Ширина, см">60</param>
                <param name="Высота, см">80</param>
                <!-- Автор обязателен для категории «Картины». -->
                <author>Художник Иван</author>
                <!-- Обязательно для картин: оригинал/original или репродукция/reproduction. -->
                <original>оригинал</original>
                <material>Холст</material>
            </offer>

            <!-- ЦВЕТЫ ОПТОМ: обязательно количество в упаковке. -->
            <offer id="wholesale1001" available="true">
                <categoryId>22</categoryId>
                <price>15000</price>
                <name>Розы оптом</name>
                <picture>https://flowwow.example/images/wholesale1001.jpg</picture>
                <description>Упаковка свежих роз.</description>
                <param name="Ширина, см">40</param>
                <param name="Высота, см">70</param>
                <!-- Обязательное количество единиц в упаковке для «Цветы оптом». -->
                <quantity_in_package>52</quantity_in_package>
                <count>10</count>
            </offer>

            <!-- ПОДАРОЧНЫЙ СЕРТИФИКАТ: электронная доставка. -->
            <offer id="cert1001" available="true">
                <categoryId>17</categoryId>
                <price>5000</price>
                <name>Электронный подарочный сертификат</name>
                <picture>https://flowwow.example/images/cert1001.jpg</picture>
                <description>Сертификат на конкретную сумму.</description>
                <!--
                  Вид сертификата обязателен. Русские значения:
                  «На услугу или товары» / «На конкретную сумму».
                  Английский алиас name: Type of certificate; значения:
                  For services or goods / For a specific amount.
                -->
                <param name="Вид сертификата">На конкретную сумму</param>
                <!--
                  Вид поставки: «материальный носитель» — физическая доставка;
                  «электронный ключ» — электронная доставка.
                  Английский алиас name: Type of delivery; значения material media
                  и electronic key.
                -->
                <param name="Вид поставки">электронный ключ</param>
                <!-- false — физическая доставка; true — электронная доставка. -->
                <downloadable>true</downloadable>
                <!-- Для подарочных сертификатов остаток обязателен. -->
                <amount>100</amount>
            </offer>
        </offers>
    </shop>
</yml_catalog>
